# Production environment for ps.kimsiah.site.
#
# Copy to `.env` on the server and fill in every CHANGEME. This is NOT .env.example with
# the values changed: it also carries the keys this app reads but never lists there, which
# is how they end up wrong in production and right everywhere else.
#
# See docs/DEPLOYMENT.md.

APP_NAME="Personal Assistant"
APP_ENV=production
# Generated ON THE SERVER with `php artisan key:generate`, and NEVER rotated afterwards.
# PASSKEYS_USER_HANDLE_SECRET falls back to this key (config/fortify.php), so changing it
# invalidates every passkey registered on this account.
APP_KEY=
APP_DEBUG=false
# Exact, and without a trailing slash. config/fortify.php derives the passkey relying
# party from it (`parse_url(config('app.url'), PHP_URL_HOST)`), so a mismatch here is a
# passkey that will not register and will not authenticate.
APP_URL=https://ps.kimsiah.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` would write every query and every request to disk on a live box.
LOG_LEVEL=warning

# Every value reading CHANGEME below is a placeholder. They carry no spaces on purpose: a
# dotenv value with unquoted whitespace makes the whole file unparseable, and the failure
# surfaces as `package:discover` aborting inside `composer install` — an error that says
# nothing about .env at all. `bun run deploy` checks for both before it installs anything.
#
# --- Database -----------------------------------------------------------------------
#
# One database, and CloudPanel's generated per-site user is enough for it. This app is
# single-user and single-tenant: it never creates a database, so it needs none of the
# extra MySQL privileges the ERP on this box required.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGEME
DB_USERNAME=CHANGEME
DB_PASSWORD=CHANGEME

# --- Session / cache / queue --------------------------------------------------------
#
# All three are MySQL. There is no Redis on this box and no queue worker.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Stays null so the cookie is host-only, which is what actually keeps this app's session
# separate from the ERP's at kimsiah.site. Setting `.kimsiah.site` on EITHER app would
# start handing that app's session cookie to the other one.
SESSION_DOMAIN=null
# Not set by default, so cookies are NOT marked Secure until you say so.
SESSION_SECURE_COOKIE=true
# Pinned rather than derived. config/session.php falls back to a slug of APP_NAME, so
# without this line renaming the app silently invalidates every live session — which has
# already happened once, in development.
SESSION_COOKIE=pa_session

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# --- Inertia SSR ---------------------------------------------------------------------
#
# 13715, NOT Inertia's default 13714 — the ERP on this box holds that one, and two SSR
# processes cannot share a port. The loser dies with EADDRINUSE, pm2 restart-loops it, and
# its Laravel keeps posting to the port and reaches the other app's render server. Both
# are the same starter kit, so `dashboard`, `auth/login` and `settings/profile` exist in
# both bundles and can genuinely resolve there. Whichever process starts first wins, so a
# reboot decides which app loses SSR.
#
# This value must match `inertia({ ssr: { port } })` in vite.config.ts, which is what the
# built bundle binds and is baked in at build time. If they disagree, Laravel posts into a
# closed port and silently falls back to client rendering with nothing logged. `bun run
# deploy` polls /health at the end of every release rather than trusting this.
INERTIA_SSR_URL=http://127.0.0.1:13715

# --- Files ----------------------------------------------------------------------------
#
# Nothing is uploaded. No media library, no public disk, no image processing.
FILESYSTEM_DISK=local

# --- Mail ------------------------------------------------------------------------------
#
# Registration and email verification are disabled, but password reset is NOT: with the
# default `log` mailer a forgotten password has no recovery path except tinker on the
# server. Wire real SMTP, or decide deliberately that tinker is the plan.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGEME
MAIL_PASSWORD=CHANGEME
MAIL_FROM_ADDRESS="no-reply@ps.kimsiah.site"
MAIL_FROM_NAME="${APP_NAME}"

# --- The owner account -------------------------------------------------------------
#
# Registration is disabled, so `php artisan db:seed --force` is the only way in. It reads
# these through config/owner.php.
#
# SEED_USER_PASSWORD is left EMPTY here on purpose, and is filled in for exactly one run:
#
#   1. put a real password here          4. blank this line again
#   2. php artisan config:cache          5. php artisan config:cache
#   3. php artisan db:seed --force
#
# Steps 2 and 5 are not optional — `optimize` at the end of a deploy caches config, and a
# cached config makes env() return null, so a value added afterwards is simply not seen.
#
# In production the seeder REFUSES a blank or weak password rather than falling back to
# the development default, and it validates against the same Password::defaults() every
# form in the app uses: 12 characters, mixed case, a number, a symbol, and not found in a
# known breach. It creates nothing if the check fails.
#
# Blank it again afterwards because it is plaintext on disk and, once the account exists,
# it is never read again — the seeder leaves an existing account untouched.
SEED_USER_NAME=CHANGEME
SEED_USER_EMAIL=CHANGEME
SEED_USER_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
