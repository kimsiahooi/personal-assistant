{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint --write .",
        "lint:check": "biome lint .",
        "check": "biome check --write .",
        "check:ci": "biome check .",
        "check:generated-types": "bun run scripts/check-generated-types.ts",
        "check:structure": "bash scripts/check-structure.sh",
        "check:validation": "bun run scripts/check-validation-parity.ts",
        "types:check": "tsc --noEmit",
        "types:generate": "php artisan typescript:transform",
        "prepare": "lefthook install"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.2",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@types/node": "^22.13.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "lefthook": "^2.1.10"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@shadcn/react": "^0.3.1",
        "@tailwindcss/vite": "^4.1.11",
        "@tanstack/react-table": "^9.1.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "cn": "^0.2.5",
        "concurrently": "^10.0.3",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^0.475.0",
        "radix-ui": "^1.6.7",
        "react": "^19.2.0",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.0",
        "react-resizable-panels": "^4",
        "recharts": "3.8.0",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vaul": "^1.1.2",
        "vite": "^8.0.0",
        "zod": "^4.4.3"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
